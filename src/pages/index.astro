---
import { getCollection, render } from "astro:content";
import SiteHeader from "../components/SiteHeader.astro";
import { getDiaryPosts } from "../lib/diary";

const diaryPosts = await getDiaryPosts();

const homeEntries = (await getCollection("home")).sort((a, b) => a.data.order - b.data.order);
const bySection = (section: string) => homeEntries.filter((entry) => entry.data.section === section);

const profileEntry = bySection("profile")[0];
const { Content: ProfileBody } = profileEntry ? await render(profileEntry) : { Content: undefined };

const profile = {
  name: profileEntry?.data.name ?? "empathless",
  status: profileEntry?.data.status ?? "",
};

const projects = bySection("project");
const timeline = bySection("timeline");
const contacts = bySection("contact").flatMap((entry) => entry.data.items ?? []);

// 没有内容的模块整块不显示，编号按实际出现的顺序排。
const sections = [
  { id: "about", label: "关于", nav: false, show: true },
  { id: "notes", label: "记录", nav: true, show: true },
  { id: "work", label: "作品", nav: true, show: projects.length > 0 },
  { id: "timeline", label: "经历", nav: true, show: timeline.length > 0 },
  { id: "contact", label: "联系", nav: true, show: contacts.length > 0 },
]
  .filter((section) => section.show)
  .map((section, index) => ({ ...section, number: String(index + 1).padStart(2, "0") }));

const sectionLabel = Object.fromEntries(
  sections.map((section) => [section.id, `${section.number} / ${section.label}`]),
);
const nav = sections
  .filter((section) => section.nav)
  .map((section) => ({ href: `#${section.id}`, label: section.label }));
const isExternal = (href?: string) => Boolean(href && /^https?:\/\//.test(href));
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={`${profile.name}：${profile.status}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{profile.name}</title>
  </head>
  <body>
    <SiteHeader nav={nav} />

    <main class="wrap">
      <h1>{profile.name}</h1>

      <section class="row hero" id="about" aria-label="关于">
        <p class="label">{sectionLabel.about}</p>
        <p class="lead">{profile.status}</p>
        <div class="aside">{ProfileBody && <ProfileBody />}</div>
      </section>

      <section class="row" id="notes" aria-label="记录">
        <p class="label">{sectionLabel.notes}</p>
        {
          diaryPosts.length > 0 ? (
            <ul class="list">
              {diaryPosts.map((post) => (
                <li>
                  <a href={post.url}>
                    <span class="title">{post.title}</span>
                    {post.date && <time datetime={post.date.replaceAll(".", "-")}>{post.date}</time>}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">还没有记录。</p>
          )
        }
      </section>

      {
        sectionLabel.work && (
          <section class="row" id="work" aria-label="作品">
            <p class="label">{sectionLabel.work}</p>
            <ul class="list">
              {projects.map((project) => (
                <li>
                  <a
                    href={project.data.href}
                    target={isExternal(project.data.href) ? "_blank" : undefined}
                    rel={isExternal(project.data.href) ? "noopener" : undefined}
                  >
                    <span class="title">
                      {project.data.title}
                      {project.data.description && <small>{project.data.description}</small>}
                    </span>
                    {project.data.type && <span class="meta">{project.data.type}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        sectionLabel.timeline && (
          <section class="row" id="timeline" aria-label="经历">
            <p class="label">{sectionLabel.timeline}</p>
            <ul class="list">
              {timeline.map((item) => (
                <li>
                  <div class="item">
                    <span class="title">
                      {item.data.title}
                      {item.data.description && <small>{item.data.description}</small>}
                    </span>
                    {item.data.time && <span class="meta">{item.data.time}</span>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        sectionLabel.contact && (
          <section class="row" id="contact" aria-label="联系">
            <p class="label">{sectionLabel.contact}</p>
            <ul class="list">
              {contacts.map((contact) => (
                <li>
                  {contact.href ? (
                    <a
                      href={contact.href}
                      target={isExternal(contact.href) ? "_blank" : undefined}
                      rel={isExternal(contact.href) ? "noopener" : undefined}
                    >
                      <span class="title">{contact.value}</span>
                      <span class="meta">{contact.label}</span>
                    </a>
                  ) : (
                    <div class="item">
                      <span class="title">{contact.value}</span>
                      <span class="meta">{contact.label}</span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </body>
</html>

<style>
  main {
    padding-bottom: clamp(64px, 10vw, 120px);
  }

  h1 {
    margin: clamp(40px, 9vw, 112px) 0 0;
    font-size: clamp(56px, 16.5vw, 216px);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.86;
    overflow-wrap: anywhere;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 16px;
    padding: 18px 0 clamp(40px, 6vw, 72px);
    border-top: 1px solid var(--line);
    scroll-margin-top: 24px;
  }

  .row.hero {
    margin-top: clamp(20px, 3vw, 32px);
    border-top: 2px solid var(--ink);
  }

  .label {
    grid-column: span 2;
    margin: 0;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .lead {
    grid-column: span 6;
    margin: 0;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .aside {
    grid-column: span 4;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.85;
  }

  .aside :global(p) {
    margin: 0;
  }

  .list,
  .empty {
    grid-column: 3 / -1;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list a,
  .list .item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .list li:first-child a,
  .list li:first-child .item {
    padding-top: 0;
  }

  .title {
    font-size: 17px;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .title small {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 400;
  }

  time,
  .meta {
    flex-shrink: 0;
    color: var(--faint);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .list a .title {
    transition: color 0.15s ease;
  }

  .list a:hover .title {
    color: var(--accent);
  }

  .empty {
    margin: 0;
    color: var(--faint);
  }

  @media (max-width: 760px) {
    .row {
      row-gap: 14px;
    }

    .label,
    .lead,
    .aside,
    .list,
    .empty {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .list a .title {
      transition: none;
    }
  }
</style>
